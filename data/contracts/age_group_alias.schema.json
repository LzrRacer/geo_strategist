{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-strategist.local/contracts/age_group_alias.schema.json",
  "title": "AgeGroupAlias",
  "type": "object",
  "additionalProperties": false,
  "required": ["age_group_id", "canonical_label", "kind", "sort_key", "aliases"],
  "properties": {
    "age_group_id": {"type": "string", "minLength": 1},
    "canonical_label": {"type": "string", "minLength": 1},
    "kind": {
      "type": "string",
      "enum": ["total", "age_band", "threshold_plus", "unknown"]
    },
    "sort_key": {"type": "integer"},
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
