{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-strategist.local/contracts/candidate_site.schema.json",
  "title": "CandidateSite",
  "type": "object",
  "additionalProperties": false,
  "required": ["site_id", "name", "prefecture", "municipality", "source_refs"],
  "properties": {
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "prefecture": {
      "type": "string",
      "minLength": 1
    },
    "municipality": {
      "type": "string",
      "minLength": 1
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "source_ref.schema.json"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
