{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-strategist.local/contracts/cashflow_projection.schema.json",
  "title": "CashflowProjection",
  "type": "object",
  "additionalProperties": false,
  "required": ["projection_id", "site_id", "rows", "input_refs"],
  "properties": {
    "projection_id": {
      "type": "string",
      "minLength": 1
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "input_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["year_index", "line_items"],
        "properties": {
          "year_index": {
            "type": "integer",
            "minimum": 0
          },
          "calendar_year": {
            "type": "integer"
          },
          "line_items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value", "unit", "provenance"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "provenance_record.schema.json"
                  }
                }
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
