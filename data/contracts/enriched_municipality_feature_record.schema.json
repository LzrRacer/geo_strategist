{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-strategist.local/contracts/enriched_municipality_feature_record.schema.json",
  "title": "EnrichedMunicipalityFeatureRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature_id", "study_area_id", "prefecture", "municipality", "geography_grain",
               "land_price_coverage_status", "healthcare_supply_coverage_status"],
  "properties": {
    "feature_id": { "type": "string", "minLength": 1 },
    "study_area_id": { "type": "string" },
    "prefecture": { "type": "string" },
    "municipality": { "type": "string" },
    "geography_grain": { "type": "string" },
    "population_feature_available": { "type": "boolean" },
    "year_earliest": { "type": ["integer", "null"] },
    "year_latest": { "type": ["integer", "null"] },
    "year_count": { "type": "integer", "minimum": 0 },
    "population_total_earliest": { "type": ["number", "null"] },
    "population_total_latest": { "type": ["number", "null"] },
    "population_total_change": { "type": ["number", "null"] },
    "population_total_pct_change": { "type": ["number", "null"] },
    "share_65_plus_earliest": { "type": ["number", "null"] },
    "share_65_plus_latest": { "type": ["number", "null"] },
    "population_65_plus_change": { "type": ["number", "null"] },
    "population_65_plus_pct_change": { "type": ["number", "null"] },
    "share_75_plus_earliest": { "type": ["number", "null"] },
    "share_75_plus_latest": { "type": ["number", "null"] },
    "elderly_dependency_proxy_earliest": { "type": ["number", "null"] },
    "elderly_dependency_proxy_latest": { "type": ["number", "null"] },
    "hospital_municipality_join_available": { "type": "boolean" },
    "hospital_join_level": { "type": "string" },
    "hospital_count_prefecture": { "type": "integer", "minimum": 0 },
    "total_known_beds_prefecture": { "type": ["number", "null"] },
    "beds_per_100k_prefecture": { "type": ["number", "null"] },
    "land_feature_available": { "type": "boolean" },
    "land_price_record_count": { "type": "integer", "minimum": 0 },
    "land_price_median": { "type": ["number", "null"] },
    "land_price_mean": { "type": ["number", "null"] },
    "land_price_min": { "type": ["number", "null"] },
    "land_price_max": { "type": ["number", "null"] },
    "land_price_latest_year": { "type": ["integer", "null"] },
    "land_price_unit": { "type": "string" },
    "land_price_coverage_status": { "type": "string" },
    "healthcare_supply_feature_available": { "type": "boolean" },
    "healthcare_supply_record_count": { "type": "integer", "minimum": 0 },
    "hospital_count_municipality": { "type": "integer", "minimum": 0 },
    "clinic_count_municipality": { "type": "integer", "minimum": 0 },
    "supply_density_per_100k": { "type": ["number", "null"] },
    "healthcare_supply_coverage_status": { "type": "string" },
    "age_group_coverage_flags": { "type": "object" },
    "issue_codes": { "type": "array", "items": { "type": "string" } }
  }
}
