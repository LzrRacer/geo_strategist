{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-strategist.local/contracts/enriched_municipality_score_record.schema.json",
  "title": "EnrichedMunicipalityScoreRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["score_id", "study_area_id", "prefecture", "municipality", "score_config_version",
               "land_score_available", "healthcare_supply_score_available",
               "bed_supply_pressure_score_available", "cash_flow_score_available",
               "score_components_used", "input_availability_flags"],
  "properties": {
    "score_id": { "type": "string", "minLength": 1 },
    "study_area_id": { "type": "string" },
    "prefecture": { "type": "string" },
    "municipality": { "type": "string" },
    "score_config_version": { "type": "string" },
    "demand_pressure_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "population_aging_pressure_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "supply_gap_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "data_completeness_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "land_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "land_score_available": { "type": "boolean" },
    "land_score_unavailable_reason": { "type": ["string", "null"] },
    "healthcare_supply_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "healthcare_supply_score_available": { "type": "boolean" },
    "healthcare_supply_score_unavailable_reason": { "type": ["string", "null"] },
    "bed_supply_pressure_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "bed_supply_pressure_score_available": { "type": "boolean" },
    "bed_supply_pressure_score_unavailable_reason": { "type": ["string", "null"] },
    "cash_flow_score_available": { "type": "boolean" },
    "cash_flow_score_unavailable_reason": { "type": "string" },
    "overall_pre_candidate_priority_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "score_components_used": { "type": "array", "items": { "type": "string" } },
    "input_availability_flags": { "type": "object" }
  }
}
