{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-strategist.local/contracts/extraction_mapping.schema.json",
  "title": "ExtractionMapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mapping_id",
    "source_table_id",
    "sheet_name",
    "status",
    "confidence"
  ],
  "properties": {
    "mapping_id": {
      "type": "string",
      "minLength": 1
    },
    "source_table_id": {
      "type": "string",
      "minLength": 1
    },
    "sheet_name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["manual_verified", "inferred", "unresolved"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "header_row": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "value_columns": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "label_columns": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "year_columns": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "age_columns": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "notes": {
      "type": ["string", "null"]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
