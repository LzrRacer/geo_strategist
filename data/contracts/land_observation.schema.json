{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-strategist.local/contracts/land_observation.schema.json",
  "title": "LandObservation",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "site_id", "metric", "value", "unit", "provenance"],
  "properties": {
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "metric": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string"
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "provenance_record.schema.json"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
