{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-strategist.local/contracts/normalized_record.schema.json",
  "title": "NormalizedRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "source_table_id",
    "source_file_path",
    "source_file_hash",
    "source_sheet",
    "source_row_number",
    "normalized_field_name",
    "normalized_value",
    "original_column",
    "value_type",
    "provenance"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "source_table_id": {
      "type": "string",
      "minLength": 1
    },
    "source_file_path": {
      "type": "string",
      "minLength": 1
    },
    "source_file_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "source_sheet": {
      "type": "string",
      "minLength": 1
    },
    "source_row_number": {
      "type": "integer",
      "minimum": 1
    },
    "source_column_number": {
      "type": "integer",
      "minimum": 1
    },
    "normalized_field_name": {
      "type": "string",
      "minLength": 1
    },
    "normalized_value": {
      "type": ["string", "number", "boolean"]
    },
    "original_column": {
      "type": "string",
      "minLength": 1
    },
    "original_header": {
      "type": "string"
    },
    "value_type": {
      "type": "string",
      "enum": ["string", "number", "date", "boolean", "formula"]
    },
    "unit": {
      "type": ["string", "null"]
    },
    "value_role": {
      "type": ["string", "null"]
    },
    "mapping_override_id": {
      "type": ["string", "null"]
    },
    "geography_labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "time_labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "age_labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "provenance_record.schema.json"
      }
    }
  }
}
