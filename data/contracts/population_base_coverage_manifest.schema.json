{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-strategist.local/contracts/population_base_coverage_manifest.schema.json",
  "title": "PopulationBaseCoverageManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "generated_at",
    "study_area_id",
    "target_prefectures",
    "input_files",
    "output_files",
    "record_counts",
    "issue_counts",
    "expectation_sources",
    "warnings"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "study_area_id": {"type": "string", "minLength": 1},
    "target_prefectures": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "input_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "output_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "record_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "issue_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "expectation_sources": {
      "type": "array",
      "items": {"type": "object"}
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
