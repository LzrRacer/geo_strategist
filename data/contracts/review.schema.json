{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-strategist.local/contracts/review.schema.json",
  "title": "Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_id", "proposal_id", "reviewer_type", "findings"],
  "properties": {
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_type": {
      "type": "string",
      "enum": ["human_reviewer", "llm_as_judge", "deterministic_validator"]
    },
    "reviewer_id": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requested_revisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "score_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
