{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-strategist.local/contracts/study_area_population_base_record.schema.json",
  "title": "StudyAreaPopulationBaseRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_record_id",
    "grain_record_id",
    "source_record_ids",
    "source_file_hash",
    "provenance",
    "study_area_id",
    "matched_target_prefecture",
    "geography_grain",
    "population_base_role",
    "value_kind"
  ],
  "properties": {
    "base_record_id": {"type": "string", "minLength": 1},
    "grain_record_id": {"type": "string", "minLength": 1},
    "source_record_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "source_file_path": {"type": ["string", "null"]},
    "source_sheet": {"type": ["string", "null"]},
    "source_file_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "provenance_record.schema.json"}
    },
    "study_area_id": {"type": "string", "minLength": 1},
    "matched_target_prefecture": {"type": "string", "minLength": 1},
    "raw_municipality": {"type": ["string", "null"]},
    "municipality": {"type": ["string", "null"]},
    "geography_grain": {
      "type": "string",
      "enum": ["prefecture_total", "municipality", "unknown"]
    },
    "population_base_role": {
      "type": "string",
      "enum": [
        "model_input_candidate",
        "context_prefecture_total",
        "excluded_requires_review"
      ]
    },
    "year": {"type": ["integer", "string", "null"]},
    "age_group": {"type": ["string", "null"]},
    "population_value": {"type": ["number", "null"]},
    "rate_value": {"type": ["number", "null"]},
    "unit": {"type": ["string", "null"]},
    "value_kind": {
      "type": "string",
      "enum": ["count", "rate"]
    }
  }
}
