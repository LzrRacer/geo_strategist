{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-strategist.local/contracts/study_area_population_record.schema.json",
  "title": "StudyAreaPopulationRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "source_record_ids",
    "source_file_hash",
    "provenance",
    "study_area_id",
    "scope_status",
    "raw_prefecture",
    "matched_target_prefecture",
    "value_kind"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "source_record_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_file_path": {
      "type": ["string", "null"]
    },
    "source_sheet": {
      "type": ["string", "null"]
    },
    "source_file_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "provenance_record.schema.json"
      }
    },
    "study_area_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_status": {
      "type": "string",
      "enum": ["in_scope", "outside_scope", "scope_unknown"]
    },
    "raw_prefecture": {
      "type": ["string", "null"]
    },
    "matched_target_prefecture": {
      "type": ["string", "null"]
    },
    "raw_municipality": {
      "type": ["string", "null"]
    },
    "prefecture": {
      "type": ["string", "null"]
    },
    "municipality": {
      "type": ["string", "null"]
    },
    "year": {
      "type": ["integer", "string", "null"]
    },
    "age_group": {
      "type": ["string", "null"]
    },
    "geography_labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "time_labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "age_labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "population_value": {
      "type": ["number", "null"]
    },
    "rate_value": {
      "type": ["number", "null"]
    },
    "unit": {
      "type": ["string", "null"]
    },
    "value_kind": {
      "type": "string",
      "enum": ["count", "rate"]
    }
  }
}
