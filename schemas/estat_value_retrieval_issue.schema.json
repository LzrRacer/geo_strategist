{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estat_value_retrieval_issue",
  "title": "e-Stat Value Retrieval Issue",
  "description": "Issue record for value retrieval pipeline (planning, fetching, parsing, normalization).",
  "type": "object",
  "required": ["issue_id", "severity", "issue_code", "message"],
  "additionalProperties": false,
  "properties": {
    "issue_id":   { "type": "string", "format": "uuid" },
    "severity":   { "type": "string", "enum": ["info", "warning", "error"] },
    "issue_code": {
      "type": "string",
      "enum": [
        "no_cached_metadata",
        "no_unambiguous_table_id",
        "ambiguous_candidates_only",
        "source_credentials_unavailable",
        "network_not_enabled",
        "network_disabled",
        "cache_miss",
        "parse_error",
        "empty_response",
        "api_error",
        "no_records_for_area",
        "dimension_code_unknown"
      ]
    },
    "message":   { "type": "string" },
    "context":   { "type": "object" }
  }
}
