{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estat_value_retrieval_result",
  "title": "e-Stat Value Retrieval Result",
  "description": "One normalized cell-value record retrieved from e-Stat getStatsData.",
  "type": "object",
  "required": [
    "record_id", "retrieval_id", "stats_data_id", "provenance",
    "retrieval_status", "numeric_parse_ok"
  ],
  "additionalProperties": false,
  "properties": {
    "record_id":            { "type": "string", "format": "uuid" },
    "retrieval_id":         { "type": "string" },
    "source_request_id":    { "type": ["string", "null"] },
    "stats_data_id":        { "type": "string" },
    "table_title":          { "type": ["string", "null"] },
    "survey_date":          { "type": ["string", "null"] },
    "area_code":            { "type": ["string", "null"] },
    "area_name":            { "type": ["string", "null"] },
    "cat01_code":           { "type": ["string", "null"] },
    "cat01_name":           { "type": ["string", "null"] },
    "cat02_code":           { "type": ["string", "null"] },
    "cat02_name":           { "type": ["string", "null"] },
    "time_code":            { "type": ["string", "null"] },
    "time_name":            { "type": ["string", "null"] },
    "unit":                 { "type": ["string", "null"] },
    "raw_value":            { "type": ["string", "null"] },
    "numeric_value":        { "type": ["number", "null"] },
    "numeric_parse_ok":     { "type": "boolean" },
    "provenance":           { "type": "string", "const": "estat_getStatsData" },
    "cache_path":           { "type": ["string", "null"] },
    "retrieval_status":     {
      "type": "string",
      "enum": ["ok", "no_data", "no_credential", "network_disabled", "cache_miss", "parse_error"]
    }
  }
}
